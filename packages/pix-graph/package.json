{
	"name": "@xynogen/pix-graph",
	"version": "0.5.1",
	"description": "Pi extension — native code knowledge graph (TS/JS exact, other languages via ast-grep)",
	"type": "module",
	"main": "src/index.ts",
	"bin": {
		"pix-graph": "src/cli.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./analyzer": "./src/analyzer.ts",
		"./extension": "./src/extension.ts"
	},
	"scripts": {
		"test": "bun test"
	},
	"files": [
		"src",
		"skills",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"src/extension.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"pix",
		"knowledge-graph",
		"code-analysis"
	],
	"author": "xynogen",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xynogen/pix-mono.git",
		"directory": "packages/pix-graph"
	},
	"homepage": "https://github.com/xynogen/pix-mono/tree/main/packages/pix-graph#readme",
	"bugs": {
		"url": "https://github.com/xynogen/pix-mono/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"typebox": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"dependencies": {
		"@xynogen/pix-pretty": "^2.1.0",
		"@xynogen/pix-runtime": "^0.20.0",
		"typescript": "^5.7.0",
		"@ast-grep/napi": "^0.45.0"
	}
}
