	"repository": {
		"type": "git",
		"url": "git+https://github.com/xynogen/pix-mono.git",
		"directory": "packages/pix-proc"
	},
	"homepage": "https://github.com/xynogen/pix-mono/tree/main/packages/pix-proc#readme",
	"bugs": {
		"url": "https://github.com/xynogen/pix-mono/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@xynogen/pix-pretty": "^1.30.0",
		"@xynogen/pix-runtime": "^0.12.0"
	},
	"peerDependencies": {
		"typebox": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
