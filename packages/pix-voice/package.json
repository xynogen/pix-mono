{
	"name": "@xynogen/pix-voice",
	"version": "0.1.5",
	"description": "Provider-neutral speech-to-text and text-to-speech tools for Pi",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./providers": "./src/providers.ts"
	},
	"scripts": {
		"test": "bun test"
	},
	"files": [
		"src",
		"!src/**/*.test.*",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"src/index.ts"
		]
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"speech",
		"tts",
		"speak",
		"stt",
		"transcribe"
	],
	"author": "xynogen",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xynogen/pix-mono.git",
		"directory": "packages/pix-voice"
	},
	"homepage": "https://github.com/xynogen/pix-mono/tree/main/packages/pix-voice#readme",
	"bugs": {
		"url": "https://github.com/xynogen/pix-mono/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"typebox": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-tui": "*"
	},
	"dependencies": {
		"@xynogen/pix-pretty": "^1.29.0",
		"@xynogen/pix-runtime": "^0.12.2"
	}
}
