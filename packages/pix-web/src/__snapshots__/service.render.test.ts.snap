exports[`captures registered fetch and search Markdown without links or external execution 1`] = `
"fetch:call

<warning>◐︎ </warning> <toolTitle+bold>fetch</toolTitle+bold> <dim>https://example.test/guide</dim>                                             
fetch:markdown

  <mdHeading+bold+underline>Guide</mdHeading+bold+underline>                                                                         
                                                                                
  <mdListBullet>- </mdListBullet><dim+bold>Read</dim+bold><dim> the code.</dim>                                                              
  <mdListBullet>- </mdListBullet><dim+italic>Test</dim+italic><dim> it.</dim>                                                                    
<success>- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - </success>
fetch:partial

   <dim>Loading...</dim>                                                                   
