   <dim>offline</dim>                                                                      
<error>- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - </error>
fetch:collapsed-success

<success>✓︎ </success> <toolTitle+bold>fetch</toolTitle+bold> <dim>https://example.test/guide</dim> <muted>·</muted> <muted>2 items · fixture</muted>                         
fetch:collapsed-error

<error>✗︎ </error> <toolTitle+bold>fetch</toolTitle+bold> <dim>https://example.test/guide</dim> <muted>·</muted> <muted>2 items · fixture</muted>                         
fetch:collapsed-cancelled

<warning>⚠︎ </warning> <toolTitle+bold>fetch</toolTitle+bold> <dim>https://example.test/guide</dim> <muted>·</muted> <muted>2 items · fixture</muted>                         
fetch:hidden-call
fetch:expanded

  <mdHeading+bold+underline>Guide</mdHeading+bold+underline>                                                                         
                                                                                
  <mdListBullet>- </mdListBullet><dim+bold>Read</dim+bold><dim> the code.</dim>                                                              
  <mdListBullet>- </mdListBullet><dim+italic>Test</dim+italic><dim> it.</dim>                                                                    
<success>- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - </success>
search:call

<warning>◐︎ </warning> <toolTitle+bold>search</toolTitle+bold> <dim>code guide</dim>                                                            
