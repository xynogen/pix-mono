{
	"name": "@xynogen/pix-web",
	"version": "0.2.4",
	"description": "Provider-neutral web fetch and search tools with plain-text output for Pi",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./providers": "./src/providers.ts",
		"./runner": "./src/runner.ts",
		"./search-providers": "./src/search-providers.ts",
		"./search-runner": "./src/search-runner.ts"
	},
	"scripts": {
		"test": "bun test"
	},
	"files": [
		"src",
		"!src/**/*.test.*",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"src/index.ts"
		]
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"fetch",
		"search"
	],
	"author": "xynogen",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xynogen/pix-mono.git",
		"directory": "packages/pix-web"
	},
	"homepage": "https://github.com/xynogen/pix-mono/tree/main/packages/pix-web#readme",
	"bugs": {
		"url": "https://github.com/xynogen/pix-mono/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"typebox": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-tui": "*"
	},
	"dependencies": {
		"@xynogen/pix-pretty": "^1.30.0",
		"@xynogen/pix-runtime": "^0.12.2"
	}
}
