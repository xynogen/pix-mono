{
	"name": "@xynogen/pix-commands",
	"version": "0.6.3",
	"description": "Pi extension — slash commands for cache clearing and isolated side questions",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./extension": "./src/extension.ts"
	},
	"scripts": {
		"test": "bun test"
	},
	"files": [
		"src",
		"!src/**/*.test.*",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"src/extension.ts"
		]
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"pix",
		"side-question",
		"concurrent"
	],
	"author": "xynogen",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xynogen/pix-mono.git",
		"directory": "packages/pix-commands"
	},
	"homepage": "https://github.com/xynogen/pix-mono/tree/main/packages/pix-commands#readme",
	"bugs": {
		"url": "https://github.com/xynogen/pix-mono/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"dependencies": {
		"@xynogen/pix-data": "^0.4.0",
		"@xynogen/pix-pretty": "^1.13.0",
		"@xynogen/pix-runtime": "^0.8.0"
	}
}
