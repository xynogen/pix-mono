{
	"name": "@xynogen/pix-runtime",
	"version": "0.20.0",
	"description": "Pix shared runtime — versioned pix.json config, atomic persistence, typed change events",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"test": "bun test"
	},
	"files": [
		"src",
		"README.md",
		"DESIGN.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"src/extension.ts"
		]
	},
	"exports": {
		".": "./src/index.ts",
		"./abort": "./src/abort.ts",
		"./action-tool": "./src/action-tool.ts",
		"./ast": "./src/ast/index.ts",
		"./atomic-write": "./src/atomic-write.ts",
		"./audio": "./src/audio.ts",
		"./binaries": "./src/binaries/index.ts",
		"./collapse": "./src/collapse.ts",
		"./config": "./src/runtime.ts",
		"./crypto": "./src/crypto.ts",
		"./exec": "./src/exec.ts",
		"./files": "./src/files.ts",
		"./fs": "./src/fs.ts",
		"./hashline": "./src/hashline.ts",
		"./host": "./src/host.ts",
		"./icon-catalog": "./src/icon-catalog.ts",
		"./io": "./src/io.ts",
		"./lfid": "./src/lfid.ts",
		"./net": "./src/net.ts",
		"./once": "./src/once.ts",
		"./os": "./src/os.ts",
		"./output": "./src/output.ts",
		"./path-access": "./src/path-access.ts",
		"./paths": "./src/paths.ts",
		"./platform": "./src/platform.ts",
		"./safe-path": "./src/safe-path.ts",
		"./sections": "./src/sections/index.ts",
		"./sftp": "./src/sftp.ts",
		"./sysstat": "./src/sysstat.ts",
		"./testing": "./src/testing.ts",
		"./tool-execution": "./src/tool-execution.ts",
		"./utf8": "./src/utf8.ts",
		"./which": "./src/which.ts"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"config",
		"runtime"
	],
	"author": "xynogen",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xynogen/pix-mono.git",
		"directory": "packages/pix-runtime"
	},
	"homepage": "https://github.com/xynogen/pix-mono/tree/main/packages/pix-runtime#readme",
	"bugs": {
		"url": "https://github.com/xynogen/pix-mono/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"typebox": "*",
		"@earendil-works/pi-tui": "*",
		"@ast-grep/napi": "^0.45.0"
	},
	"dependencies": {
		"systeminformation": "5.33.19",
		"xxhash-wasm": "1.1.0"
	},
	"peerDependenciesMeta": {
		"@ast-grep/napi": {
			"optional": true
		}
	},
	"devDependencies": {
		"@ast-grep/napi": "^0.45.0"
	}
}
