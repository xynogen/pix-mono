{
	"name": "@xynogen/pix-bash",
	"version": "0.2.17",
	"description": "Pi tool — bash shell execution with pretty output",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./extension": "./src/extension.ts"
	},
