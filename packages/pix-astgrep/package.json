{
	"name": "@xynogen/pix-astgrep",
	"version": "0.2.0",
	"description": "Pi extension — AST-aware structural search and symbol reads (ast-grep, opt-in)",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./extension": "./src/extension.ts"
	},
	"scripts": {
		"test": "bun test"
	},
	"files": [
		"src",
		"!src/**/*.test.*",
		"!src/**/*.fixture.*",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"src/extension.ts"
		]
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"pix",
		"ast-grep"
	],
	"author": "xynogen",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xynogen/pix-mono.git",
		"directory": "packages/pix-astgrep"
	},
	"homepage": "https://github.com/xynogen/pix-mono/tree/main/packages/pix-astgrep#readme",
	"bugs": {
		"url": "https://github.com/xynogen/pix-mono/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"typebox": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"dependencies": {
		"@ast-grep/napi": "^0.45.0",
